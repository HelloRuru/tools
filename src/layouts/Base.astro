---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'HelloRuru 免費線上工具箱 — 全程本機處理，保護你的隱私' } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Kaoru Tsai" />
  <link rel="canonical" href="https://tools.helloruru.com/" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icon-192x192.png" />

  <!-- OG -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://tools.helloruru.com/og-image.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://tools.helloruru.com/" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://tools.helloruru.com/og-image.png" />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content="HelloRuru 工具箱" />

  <!-- JSON-LD: WebSite + Person（GEO） -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'HelloRuru 工具箱',
    alternateName: 'HelloRuru Tools',
    url: 'https://tools.helloruru.com/',
    description: 'HelloRuru 免費線上工具箱，23 款工具全程本機處理，涵蓋文字轉檔、電子書、圖片處理、社群排版與閱讀工具。',
    inLanguage: 'zh-TW',
    author: {
      '@type': 'Person',
      name: 'Kaoru Tsai',
      url: 'https://lab.helloruru.com/about/',
    },
  })} />

  <!-- Brand Header Web Component -->
  <script src="https://lab.helloruru.com/shared/brand-header.js"></script>

  <!-- 深色模式初始化（避免閃爍） -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
